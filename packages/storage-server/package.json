{
  "name": "@notesapp/storage-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json",
    "test:unit": "node ../../tools/run-tests.mjs unit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@notesapp/core": "workspace:*",
    "@notesapp/markdown": "workspace:*",
    "@notesapp/note-document": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:toolchain"
  }
}
