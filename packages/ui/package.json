{
  "name": "@notesapp/ui",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./public-footer": {
      "types": "./dist/public-footer.d.ts",
      "default": "./dist/public-footer.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "default": "./dist/static.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json",
    "test:unit": "node ../../tools/run-tests.mjs unit"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:toolchain"
  }
}
