# Nonsecret Compose configuration.
# Copy this file to .env and replace each example value.

# Required. The public URL of this installation. Compose fails to start when
# it is not set. Cookies and absolute URLs belong to this origin.
NOTESAPP_ORIGIN=https://notes.example.com

# Optional. More origins that this installation serves, separated by commas.
# Write each one in full, with its scheme and, when the port is not the default
# port of that scheme, its port. Use the scheme of NOTESAPP_ORIGIN for each one.
# An empty value serves NOTESAPP_ORIGIN and nothing else.
NOTESAPP_ADDITIONAL_ORIGINS=

# Optional. The origin that serves published pages and nothing else. Use a
# host name that no other origin of this installation uses, and the scheme of
# NOTESAPP_ORIGIN. A public installation needs it before it opens registration.
# An empty value serves published pages from NOTESAPP_ORIGIN.
NOTESAPP_PUBLISHED_ORIGIN=

# The address and port that publish the application on the host. Keep the
# loopback address and put an HTTPS reverse proxy in front of it. The server
# inside the container always listens on port 3000.
NOTESAPP_BIND_HOST=127.0.0.1
NOTESAPP_PORT=3000

# The proxies whose forwarded headers this installation believes. An empty
# value believes none of them, so the client address is the address of the
# caller that reaches the listening port. Name an IP address, a range in CIDR
# form, or one of loopback, linklocal and uniquelocal, and separate two entries
# with a comma. The attempt limits count each client only when this value names
# the proxy in front. Read docs/guide/operations.md before you name a range.
NOTESAPP_TRUSTED_PROXIES=

# The optional TLS profile. `docker compose --profile tls up -d` starts Caddy
# in front of the application. NOTESAPP_DOMAIN is the domain that Caddy
# answers, and Caddy gets the certificate for it. An empty value answers
# localhost with a certificate that Caddy makes itself, which serves a local
# check and nothing else. NOTESAPP_TLS_DIR holds the certificate and its
# private key, so put it on encrypted host storage.
NOTESAPP_DOMAIN=
# The host name of NOTESAPP_PUBLISHED_ORIGIN, which the proxy answers too. An
# empty value answers pages.localhost, which serves a local check only.
NOTESAPP_PUBLISHED_DOMAIN=
NOTESAPP_TLS_DIR=/srv/notesapp/tls

NOTESAPP_LOG_LEVEL=info
NOTESAPP_MAX_BODY_BYTES=1048576
NOTESAPP_MAX_HEADER_BYTES=16384
# The whole request must arrive inside this time, and that includes the body
# of an image upload over a slow link. Keep it well above the idle bound below.
NOTESAPP_REQUEST_TIMEOUT_MS=60000
# The longest gap between two chunks of an upload body, in milliseconds. It
# must be shorter than NOTESAPP_REQUEST_TIMEOUT_MS. An empty value keeps the
# default of the server.
NOTESAPP_UPLOAD_IDLE_TIMEOUT_MS=
NOTESAPP_RATE_LIMIT_WINDOW_S=60
NOTESAPP_RATE_LIMIT_MAX=100

# The stop of the server, in milliseconds. The first value is the time between
# the moment the server reports that it is not ready and the moment it closes
# its listener, so the reverse proxy in front can send new traffic elsewhere.
# Set it to 0 when no proxy is in front. The second value is the whole budget
# from the stop signal to a forced end, and it must be the larger of the two.
# An empty value keeps the default of the server.
NOTESAPP_SHUTDOWN_GRACE_MS=
NOTESAPP_SHUTDOWN_DEADLINE_MS=

# The storage limit that a new account starts with, in bytes, and how long a
# new invitation works, in hours. An administrator changes the limit of one
# account in the application. An empty value keeps the default of the server.
NOTESAPP_ACCOUNT_LIMIT_BYTES=
NOTESAPP_INVITATION_LIFETIME_HOURS=

# Optional. How many hours a sign-up of open registration waits for the person
# to open the link in its message. After that the server removes it. An empty
# value waits 24 hours.
NOTESAPP_PENDING_ACCOUNT_HOURS=

# Optional. The standing of a new account, active or locked. A locked account
# signs in to one screen and can only export its notes, remove itself, or open
# the account portal. With locked, the second value can give its life before
# the daily run removes it, as a number of days and d, for example 30d. Empty
# values keep every new account active with no removal time.
NOTESAPP_NEW_ACCOUNT_STANDING=
NOTESAPP_NEW_ACCOUNT_REMOVE_AFTER=

# Optional. Who can make an account: invitation or open. A value here wins
# over the accounts page, which then offers no change. Open needs a mail server
# and both legal documents in the environment too, or the server does not
# start. Empty leaves the choice to an administrator.
NOTESAPP_REGISTRATION_POLICY=

# Optional. The operator API of a service such as a billing service. The
# first value is the path in the container of a file that holds one secret of
# at least 32 characters. The second is the account portal of that service,
# which every account opens from Settings and a locked account opens to unlock
# itself. Empty values turn both off.
NOTESAPP_OPERATOR_TOKEN_FILE=
NOTESAPP_ACCOUNT_PORTAL_URL=

# Optional. The caps of the whole installation for one calendar month in UTC:
# the bytes that the published pages send, the bytes that the accounts
# download, and the write calls and the read calls to an S3 store. Past a cap
# the published pages close, the downloads stop, or the uploads and the
# images stop, until the next month. Empty values set no cap.
NOTESAPP_PUBLISHED_TRANSFER_CAP_BYTES=
NOTESAPP_DOWNLOAD_CAP_BYTES=
NOTESAPP_OBJECT_WRITE_CAP=
NOTESAPP_OBJECT_READ_CAP=

# Optional. How hard the proof of work of a sign-up is, from 8 to 28. Each step
# doubles the time that a browser takes. An empty value keeps 16, which takes a
# browser a few seconds.
NOTESAPP_SIGNUP_DIFFICULTY=

# Optional. The terms and the privacy notice of the service. Leave these empty
# to set both documents in the application instead: Settings, Manage accounts,
# Legal documents. A value here wins and locks that page. Each one takes a
# version, and either an address on another site here, or a file that the
# server shows itself through docker/compose.legal.yaml. Name both documents
# or neither. When you raise a version, each account accepts it again before
# the application opens. A public installation needs both before it opens
# registration.
NOTESAPP_TERMS_URL=
NOTESAPP_TERMS_VERSION=
NOTESAPP_PRIVACY_URL=
NOTESAPP_PRIVACY_VERSION=

# Optional. The directory that holds terms.md and privacy.md, which
# docker/compose.legal.yaml mounts. Copy each template from the Legal documents
# section of the application here and fill every blank in double braces. The
# server refuses to start while a blank is left. Keep this directory outside
# this checkout.
NOTESAPP_LEGAL_DIR=/etc/notesapp/legal

# Optional. The mail server, which docker/compose.mail.yaml adds.
# Invitations, sign-up and password reset need mail. Write each value as it
# is, with no percent encoding. The security mode is tls, starttls or none.
# The password is the secret file smtp_password in NOTESAPP_SECRETS_DIR.
# Leave the override out to set the mail server in the application instead:
# Settings, Manage accounts, Mail. A transport here wins and locks that page.
NOTESAPP_SMTP_HOST=smtp.example.com
NOTESAPP_SMTP_PORT=465
NOTESAPP_SMTP_SECURITY=tls
NOTESAPP_SMTP_USERNAME=no-reply@notes.example.com
NOTESAPP_MAIL_FROM=tidy notebook <no-reply@notes.example.com>

# Optional. An S3 compatible store for the uploads, the images and the imports
# of the notes, which docker/compose.s3.yaml adds. Without the override they
# stay in NOTESAPP_STORAGE_DIR. The endpoint names Cloudflare R2 or MinIO, and
# AWS needs none. The key pair is the secret files s3_access_key_id and
# s3_secret_access_key in NOTESAPP_SECRETS_DIR.
NOTESAPP_S3_BUCKET=notes-uploads
NOTESAPP_S3_REGION=auto
NOTESAPP_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com

# Optional. The Compose files that `docker compose` reads, separated by colons.
# A public installation adds the mail transport and the legal documents:
# COMPOSE_FILE=docker-compose.yml:docker/compose.mail.yaml:docker/compose.legal.yaml
COMPOSE_FILE=docker-compose.yml

# A new password is checked against the range service of Have I Been Pwned.
# The service sees five characters of a digest and never the password. Set
# this to off for an installation with no outbound network.
NOTESAPP_BREACH_CHECK=on

# Container log rotation for both services.
NOTESAPP_LOG_MAX_SIZE=10m
NOTESAPP_LOG_MAX_FILE=5

# The image name and tag that `docker compose build` writes and
# `docker compose up` runs. Use a version tag for a published image.
NOTESAPP_IMAGE=notesapp:latest

POSTGRES_USER=postgres
POSTGRES_DB=notesapp

# Host directories on encrypted storage, outside this checkout. All three are
# required and none has a default. Create them before the first start:
#
#   sudo mkdir -p /srv/notesapp/postgres /srv/notesapp/storage
#   sudo chown 10001:10001 /srv/notesapp/storage
#
# The storage directory must belong to uid 10001, which is the notesapp user
# of the image. PostgreSQL sets the owner of its own directory.
NOTESAPP_DATABASE_DIR=/srv/notesapp/postgres
NOTESAPP_STORAGE_DIR=/srv/notesapp/storage

# This directory is outside the repository. Its files must use mode 0600 and
# owner uid 10001, which is the notesapp user of the image.
NOTESAPP_SECRETS_DIR=/etc/notesapp/secrets
