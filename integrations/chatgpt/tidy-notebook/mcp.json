{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tidy-notebook": {
      "type": "streamable-http",
      "url": "https://mcp.tidynotebook.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["notes:read"],
            "defaultScopes": ["notes:write", "offline_access"]
          }
        }
      }
    }
  }
}
